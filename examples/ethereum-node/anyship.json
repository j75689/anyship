{
  "version": 1,
  "name": "eth-mainnet",
  "services": {
    "reth": {
      "kind": "server",
      "image": "ghcr.io/paradigmxyz/reth:latest",
      "start": "reth node --chain mainnet --datadir /data --http --http.addr 0.0.0.0 --http.api eth,net,web3 --authrpc.addr 0.0.0.0 --authrpc.jwtsecret /run/secrets/JWT_SECRET",
      "ports": [
        { "name": "p2p", "port": 30303, "protocol": "tcp+udp", "exposure": "public" },
        { "name": "rpc", "port": 8545, "protocol": "http", "exposure": "internal" },
        { "name": "engine", "port": 8551, "protocol": "http", "exposure": "internal" }
      ],
      "volumes": [{ "name": "reth-data", "mountPath": "/data", "size": "2TB", "class": "nvme" }],
      "secrets": ["JWT_SECRET"]
    },
    "lighthouse": {
      "kind": "server",
      "image": "sigp/lighthouse:latest",
      "start": "lighthouse bn --network mainnet --datadir /data --http --http-address 0.0.0.0 --execution-endpoint http://reth:8551 --execution-jwt /run/secrets/JWT_SECRET --checkpoint-sync-url https://mainnet.checkpoint.sigp.io",
      "ports": [
        { "name": "p2p", "port": 9000, "protocol": "tcp+udp", "exposure": "public" },
        { "name": "api", "port": 5052, "protocol": "http", "exposure": "internal" }
      ],
      "volumes": [{ "name": "lighthouse-data", "mountPath": "/data", "size": "200GB", "class": "nvme" }],
      "secrets": ["JWT_SECRET"],
      "dependsOn": ["reth"]
    }
  },
  "secrets": {
    "JWT_SECRET": {
      "generate": "hex32",
      "description": "Engine API secret shared by the execution and consensus clients"
    }
  }
}
