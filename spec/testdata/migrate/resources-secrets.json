{
  "version": 1,
  "name": "shop",
  "services": {
    "api": {
      "kind": "server",
      "path": "api",
      "dockerfile": "api/Dockerfile",
      "start": "./server",
      "ports": [
        { "name": "http", "port": 8080, "protocol": "http", "exposure": "public" },
        { "name": "metrics", "port": 9090, "exposure": "internal" }
      ],
      "env": { "LOG_LEVEL": "info" },
      "uses": ["db", "cache"],
      "secrets": ["STRIPE_KEY", "SESSION_SECRET"],
      "healthCheck": { "path": "/healthz" },
      "runtime": { "language": "go", "edgeCompatible": false },
      "replicas": 2
    },
    "mailer": {
      "kind": "worker",
      "path": "worker",
      "start": "./worker",
      "uses": ["cache"],
      "secrets": ["SESSION_SECRET"],
      "cron": [{ "schedule": "*/5 * * * *", "command": "./worker flush" }],
      "dependsOn": ["api"]
    },
    "site": {
      "kind": "static",
      "path": "web",
      "build": { "command": "npm run build", "output": "dist" }
    }
  },
  "resources": {
    "db": { "type": "postgres" },
    "cache": { "type": "redis", "external": true }
  },
  "secrets": {
    "STRIPE_KEY": { "description": "Stripe secret key" },
    "SESSION_SECRET": { "generate": "hex32" }
  }
}
