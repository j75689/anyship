{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/j75689/anyship/main/schema/anyship.schema.json",
  "$defs": {
    "Build": {
      "properties": {
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string",
          "description": "Build output directory, relative to the service path."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Cron": {
      "properties": {
        "schedule": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Path of this service to call over HTTP when the schedule fires, e.g. \"/internal/tick\". Instead of command."
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD"
          ],
          "description": "HTTP method for path; POST by default."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schedule"
      ]
    },
    "HealthCheck": {
      "properties": {
        "path": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Lowercase letters, digits and dashes, starting with a letter."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "Port": {
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "tcp",
            "udp",
            "tcp+udp"
          ]
        },
        "exposure": {
          "type": "string",
          "enum": [
            "public",
            "internal"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "port"
      ]
    },
    "Resource": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "sqlite",
            "redis",
            "bucket",
            "kv"
          ]
        },
        "external": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "Runtime": {
      "properties": {
        "language": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "edgeCompatible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "properties": {
        "generate": {
          "type": "string",
          "enum": [
            "hex32"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Service": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "static",
            "server",
            "worker"
          ]
        },
        "path": {
          "type": "string",
          "description": "Source directory, relative to the spec file. Defaults to \".\"."
        },
        "image": {
          "type": "string"
        },
        "dockerfile": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "start": {
          "type": "string",
          "description": "Command that starts the process."
        },
        "entry": {
          "type": "string",
          "description": "Module exporting a fetch handler, for edge runtimes. Relative to path."
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": "array"
        },
        "domains": {
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
          },
          "type": "array",
          "description": "Custom domains this service answers on, e.g. \"app.example.com\". Needs a public http port. Wildcards are not supported."
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/Volume"
          },
          "type": "array"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^([1-9]\\d{0,5})(MB|GB)$",
          "description": "Memory one instance needs, like \"512MB\" or \"4GB\"."
        },
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "CPUs one instance needs, like 0.5, 1 or 2."
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "secrets": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Names of top-level secrets this service receives."
        },
        "uses": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Names of top-level resources this service binds to."
        },
        "cron": {
          "items": {
            "$ref": "#/$defs/Cron"
          },
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "healthCheck": {
          "$ref": "#/$defs/HealthCheck"
        },
        "dependsOn": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "Spec": {
      "properties": {
        "services": {
          "additionalProperties": {
            "$ref": "#/$defs/Service"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": "object"
        },
        "resources": {
          "additionalProperties": {
            "$ref": "#/$defs/Resource"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "$ref": "#/$defs/Secret"
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": "object"
        },
        "targets": {
          "additionalProperties": true,
          "type": "object",
          "description": "Per-platform overrides keyed by adapter name."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "services"
      ]
    },
    "Volume": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "size": {
          "type": "string",
          "pattern": "^\\d+(GB|TB)$",
          "description": "Size like \"20GB\" or \"2TB\"."
        },
        "class": {
          "type": "string",
          "enum": [
            "standard",
            "nvme"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "mountPath",
        "size"
      ]
    }
  },
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "anyship/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "App"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "anyship deploy spec"
}
